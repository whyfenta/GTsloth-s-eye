{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "noEmit": true, "skipLibCheck": true, "esModuleInterop": true,
    "allowImportingTsExtensions": true, "types": ["node", "vite/client"]
  },
  "include": ["src", "tests", "scripts/*.ts"]
}
